# Vercel / Production Environment Variables

# GOOGLE_CLOUD_API_KEY: Your Google Cloud Text-to-Speech API key (from Celoris n8n project)
GOOGLE_CLOUD_API_KEY="AIzaSy..."

# ADMIN_PASSWORD: Secret password to lock the app for Admin-only access.
# If set, any visitor must enter this password to generate speech or consume your Google Cloud quota.
ADMIN_PASSWORD="your-secure-admin-passkey"
